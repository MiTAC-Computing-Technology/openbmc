From feec41bca2db5a8cc0007ac3a0f22211637217c3 Mon Sep 17 00:00:00 2001
From: "fredy.chen" <fredy.chen@mitaccomputing.com>
Date: Thu, 25 Jun 2026 23:01:36 -0400
Subject: [PATCH] Update IPMI Firmware Version for miobmc

Upstream-Status: Inappropriate [No upstream maintenance]
---
 include/appcommands.hpp |  2 +-
 src/appcommands.cpp     | 89 +++++++++++++----------------------------
 2 files changed, 28 insertions(+), 63 deletions(-)

diff --git a/include/appcommands.hpp b/include/appcommands.hpp
index f4cd0d6..9670aed 100644
--- a/include/appcommands.hpp
+++ b/include/appcommands.hpp
@@ -25,8 +25,8 @@ typedef struct
     std::string platform;
     uint8_t major;
     uint8_t minor;
+    uint32_t patchNo;
     uint32_t buildNo;
-    std::string openbmcHash;
     std::string metaHash;
 } MetaRevision;
 #pragma pack(pop)
diff --git a/src/appcommands.cpp b/src/appcommands.cpp
index ffe5da6..513fae9 100644
--- a/src/appcommands.cpp
+++ b/src/appcommands.cpp
@@ -200,72 +200,33 @@ int getActiveSoftwareVersionInfo(ipmi::Context::ptr ctx,
     return -1;
 }
 
-// Support both 2 solutions:
-// 1.Current solution  2.7.0-dev-533-g14dc00e79-5e7d997
-//   openbmcTag  2.7.0-dev
-//   BuildNo     533
-//   openbmcHash 14dc00e79
-//   MetaHasg    5e7d997
-//
-// 2.New solution  wht-0.2-3-gab3500-38384ac or wht-2000.2.3-gab3500-38384ac
-//   IdStr        wht
-//   Major        0
-//   Minor        2
-//   buildNo      3
-//   MetaHash     ab3500
-//   openbmcHash  38384ac
+//   Miobmc solution 2.18.0-556-g2d45f2c045
+//   Major       2
+//   Minor       18
+//   PatchNo     0
+//   BuildNo     0
+//   MetaHash    2d45f2c045
 std::optional<MetaRevision> convertIntelVersion(std::string& s)
 {
     std::smatch results;
     MetaRevision rev;
-    std::regex pattern1("(\\d+?).(\\d+?).\\d+?-\\w*?-(\\d+?)-g(\\w+?)-(\\w+?)");
-    constexpr size_t matchedPhosphor = 6;
-    if (std::regex_match(s, results, pattern1))
+    // Pattern major.minor.third-number(?.fourth-number)(?-(n commit)-(ghash))
+    constexpr size_t matchedMiobmc = 7;
+    std::regex pattern(R"(^(\d+)\.(\d+)\.(\d+)(?:\.(\d+))?(?:-(\d+)-g([0-9a-fA-F]+))?(?:-dirty)?$)");
+    if (std::regex_match(s, results, pattern))
     {
-        if (results.size() == matchedPhosphor)
+        if (results.size() == matchedMiobmc)
         {
-            rev.platform = "whtref";
+            rev.platform = "miobmc";
             rev.major = static_cast<uint8_t>(std::stoi(results[1]));
             rev.minor = static_cast<uint8_t>(std::stoi(results[2]));
-            rev.buildNo = static_cast<uint32_t>(std::stoi(results[3]));
-            rev.openbmcHash = results[4];
-            rev.metaHash = results[5];
-            std::string versionString =
-                rev.platform + ":" + std::to_string(rev.major) + ":" +
-                std::to_string(rev.minor) + ":" + std::to_string(rev.buildNo) +
-                ":" + rev.openbmcHash + ":" + rev.metaHash;
-            phosphor::logging::log<phosphor::logging::level::INFO>(
-                "Get BMC version",
-                phosphor::logging::entry("VERSION=%s", versionString.c_str()));
+            rev.patchNo = static_cast<uint32_t>(std::stoi(results[3]));
+            rev.buildNo = results[4].str().empty() ? 0 : static_cast<uint32_t>(std::stoi(results[4]));
+            rev.metaHash = results[6];
             return rev;
         }
     }
-    constexpr size_t matchedIntel = 7;
-    std::regex pattern2("(\\w+?)-(\\d+?).(\\d+?)[-.](\\d+?)-g(\\w+?)-(\\w+?)");
-    if (std::regex_match(s, results, pattern2))
-    {
-        if (results.size() == matchedIntel)
-        {
-            rev.platform = results[1];
-            std::string majorVer = results[2].str();
-            // Take only the last two digits of the major version
-            rev.major = static_cast<uint8_t>(
-                std::stoi(majorVer.substr(majorVer.size() - 2)));
-            rev.minor = static_cast<uint8_t>(std::stoi(results[3]));
-            rev.buildNo = static_cast<uint32_t>(std::stoi(results[4]));
-            rev.openbmcHash = results[6];
-            rev.metaHash = results[5];
-            std::string versionString =
-                rev.platform + ":" + std::to_string(rev.major) + ":" +
-                std::to_string(rev.minor) + ":" + std::to_string(rev.buildNo) +
-                ":" + rev.openbmcHash + ":" + rev.metaHash;
-            phosphor::logging::log<phosphor::logging::level::INFO>(
-                "Get BMC version",
-                phosphor::logging::entry("VERSION=%s", versionString.c_str()));
-            return rev;
-        }
-    }
-
+    
     return std::nullopt;
 }
 
@@ -412,16 +373,20 @@ RspType<uint8_t,  // Device ID
             if (rev.has_value())
             {
                 MetaRevision revision = rev.value();
-                devId.fwMajor = static_cast<uint7_t>(revision.major);
+                devId.fwMajor = static_cast<uint7_t>(revision.patchNo);
 
-                revision.minor = (revision.minor > 99 ? 99 : revision.minor);
-                devId.fwMinor = revision.minor % 10 +
-                                (revision.minor / 10) * 16;
+                revision.buildNo = (revision.buildNo > 99 ? 99 : revision.buildNo);
+                devId.fwMinor = revision.buildNo % 10 +
+                                (revision.buildNo / 10) * 16;
                 try
                 {
-                    uint32_t hash = std::stoul(revision.metaHash, 0, 16);
-                    hash = bswap_32(hash);
-                    devId.aux = (revision.buildNo & 0xFF) + (hash & 0xFFFFFF00);
+                    uint32_t hash = 0;
+                    if(!revision.metaHash.empty()){
+                        std::string metaHash = revision.metaHash.substr(0, 8);
+                        hash = std::stoul(metaHash, nullptr, 16);
+                        hash = bswap_32(hash);
+                    }
+                    devId.aux = (revision.minor << 24) + (revision.major << 16) + (hash & 0xFFFF);
                     fwVerInitialized = true;
                 }
                 catch (const std::exception& e)
-- 
2.34.1

