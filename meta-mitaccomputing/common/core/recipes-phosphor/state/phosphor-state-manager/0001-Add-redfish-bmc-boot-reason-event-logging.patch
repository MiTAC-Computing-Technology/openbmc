+namespace
+{
+
+constexpr auto pendingBootReasonPath = "/var/log/bmc_boot_reason_logged";
+constexpr auto rebootCauseCachePath =
+    "/run/phosphor-state-manager/bmc_reboot_cause_cache";
+
+struct RebootCauseInfo
+{
+    server::BMC::RebootCause cause;
+    std::string_view cacheValue;
+    std::string_view redfishMessage;
+    std::string_view pendingReason;
+};
+
+constexpr RebootCauseInfo unknownRebootCauseInfo{
+    server::BMC::RebootCause::Unknown, "Unknown", "unknown reset", ""};
+
+constexpr std::array rebootCauseTable{
+    RebootCauseInfo{server::BMC::RebootCause::POR, "POR", "AC power applied",
+                    ""},
+    RebootCauseInfo{server::BMC::RebootCause::PinholeReset, "PinholeReset",
+                    "pinhole reset", ""},
+    RebootCauseInfo{server::BMC::RebootCause::Watchdog, "Watchdog",
+                    "watchdog reset", ""},
+    RebootCauseInfo{server::BMC::RebootCause::Software, "Software",
+                    "software reset", ""},
+    RebootCauseInfo{server::BMC::RebootCause::FirmwareUpdate, "FirmwareUpdate",
+                    "firmware update", "firmware update"},
+    RebootCauseInfo{server::BMC::RebootCause::ColdResetCommand,
+                    "ColdResetCommand", "cold reset command",
+                    "cold reset command"},
+    unknownRebootCauseInfo,
+};
+
+constexpr const RebootCauseInfo& getRebootCauseInfo(
+    const server::BMC::RebootCause cause)
+{
+    for (const auto& info : rebootCauseTable)
+    {
+        if (info.cause == cause)
+        {
+            return info;
+        }
+    }
+
+    return unknownRebootCauseInfo;
+}
+
+constexpr const RebootCauseInfo* findRebootCauseByCacheValue(
+    const std::string_view value)
+{
+    for (const auto& info : rebootCauseTable)
+    {
+        if (info.cacheValue == value)
+        {
+            return &info;
+        }
+    }
+
+    return nullptr;
+}
+
+constexpr const RebootCauseInfo* findRebootCauseByPendingReason(
+    const std::string_view reason)
+{
+    for (const auto& info : rebootCauseTable)
+    {
+        if (!info.pendingReason.empty() && info.pendingReason == reason)
+        {
+            return &info;
+        }
+    }
+
+    return nullptr;
+}
+
+std::optional<std::string> readNonEmptyFirstLine(
+    const std::filesystem::path& path)
+{
+    std::error_code ec;
+    const bool fileExists = std::filesystem::exists(path, ec);
+    if (ec)
+    {
+        error("Failed to check {FILE}: {ERROR}", "FILE", path.c_str(), "ERROR",
+              ec.message());
+        return std::nullopt;
+    }
+    if (!fileExists)
+    {
+        return std::nullopt;
+    }
+
+    std::ifstream file(path);
+    if (!file)
+    {
+        error("Failed to open {FILE}", "FILE", path.c_str());
+        return std::nullopt;
+    }
+
+    std::string content;
+    if (!std::getline(file, content))
+    {
+        if (file.eof())
+        {
+            error("Empty content in {FILE}", "FILE", path.c_str());
+        }
+        else
+        {
+            error("Failed to read {FILE}", "FILE", path.c_str());
+        }
+        return std::nullopt;
+    }
+
+    if (content.empty())
+    {
+        error("Empty content in {FILE}", "FILE", path.c_str());
+        return std::nullopt;
+    }
+
+    return content;
+}
+
+bool writeTextFile(const std::filesystem::path& path,
+                   const std::string_view content)
+{
+    std::ofstream file(path, std::ios::out | std::ios::trunc);
+    if (!file)
+    {
+        error("Failed to create {FILE}", "FILE", path.c_str());
+        return false;
+    }
+
+    file << content;
+    file.close();
+    if (!file)
+    {
+        error("Failed to write {FILE}", "FILE", path.c_str());
+        return false;
+    }
+
+    return true;
+}
+
+void removeFile(const std::filesystem::path& path)
+{
+    std::error_code ec;
+    std::filesystem::remove(path, ec);
+    if (ec)
+    {
+        error("Failed to remove {FILE}: {ERROR}", "FILE", path.c_str(), "ERROR",
+              ec.message());
+    }
+}
+
