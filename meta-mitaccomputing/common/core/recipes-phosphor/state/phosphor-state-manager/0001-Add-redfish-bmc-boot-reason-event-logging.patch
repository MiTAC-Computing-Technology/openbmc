 }
 
+std::string BMC::getBMCVersion()
+{
+    constexpr std::string_view versionKey = "VERSION_ID=";
+    std::ifstream file("/etc/os-release");
+    std::string line;
+
+    while (std::getline(file, line))
+    {
+        if (line.compare(0, versionKey.size(), versionKey.data()) == 0)
+        {
+            auto version = line.substr(versionKey.size());
+            if (version.size() >= 2 && version.front() == '"' &&
+                version.back() == '"')
+            {
+                version = version.substr(1, version.size() - 2);
+            }
+            return version;
+        }
+    }
+
+    return {};
+}
+
+void BMC::logRedfishBootReason(const std::string& message) const
+{
+    const std::string msgId = "OpenBMC.0.5.BMCBootReason";
+    const auto msgArgs = std::format("{},{}", bmcVersion, message);
+
+    info("{LOG_MSG}", "LOG_MSG", message, "REDFISH_MESSAGE_ID", msgId,
+         "REDFISH_MESSAGE_ARGS", msgArgs);
+}
+
+bool BMC::writePendingBootReason(const std::string& reason) const
+{
+    return writeTextFile(pendingBootReasonPath, reason);
+}
+
+void BMC::removePendingBootReason() const
+{
+    removeFile(pendingBootReasonPath);
+}
+
+std::optional<std::string> BMC::consumePendingBootReason() const
+{
+    auto loggedReason = readNonEmptyFirstLine(pendingBootReasonPath);
+    removePendingBootReason();
+    return loggedReason;
+}
+
+std::optional<BMC::RebootCause> BMC::readCachedRebootCause() const
+{
+    const auto cause = readNonEmptyFirstLine(rebootCauseCachePath);
+    if (!cause)
+    {
+        removeFile(rebootCauseCachePath);
+        return std::nullopt;
+    }
+
+    if (const auto* info = findRebootCauseByCacheValue(*cause))
+    {
+        return info->cause;
+    }
+
+    error("Invalid reboot cause {CAUSE} in {FILE}", "CAUSE", *cause, "FILE",
+          rebootCauseCachePath);
+    removeFile(rebootCauseCachePath);
+    return std::nullopt;
+}
+
+void BMC::writeCachedRebootCause(const RebootCause rebootCause) const
+{
+    const auto& info = getRebootCauseInfo(rebootCause);
+    const std::filesystem::path markerPath{rebootCauseCachePath};
+    std::error_code ec;
+    std::filesystem::create_directories(markerPath.parent_path(), ec);
+    if (ec)
+    {
+        error("Failed to create directory for {FILE}: {ERROR}", "FILE",
+              rebootCauseCachePath, "ERROR", ec.message());
+        return;
+    }
+
+    writeTextFile(markerPath, info.cacheValue);
+}
+
+void BMC::updateRedfishEventLog()
+{
+    if (readCachedRebootCause())
+    {
+        return;
+    }
+
+    const auto rebootCause = server::BMC::lastRebootCause();
+    const auto& info = getRebootCauseInfo(rebootCause);
+    logRedfishBootReason(std::string(info.redfishMessage));
+    writeCachedRebootCause(info.cause);
+}
+
 void BMC::discoverLastRebootCause()
 {
+    const auto savedCause = readCachedRebootCause();
+    if (savedCause)
+    {
+        this->lastRebootCause(*savedCause);
+        return;
+    }
+
     uint64_t bootReason = 0;
     std::ifstream file;
     const auto* bootstatusPath = "/sys/class/watchdog/watchdog0/bootstatus";
@@ -302,12 +577,31 @@ void BMC::discoverLastRebootCause()
     switch (bootReason)
     {
         case WDIOF_EXTERN1:
+            removePendingBootReason();
             this->lastRebootCause(RebootCause::Software);
             return;
         case WDIOF_CARDRESET:
-            this->lastRebootCause(RebootCause::Watchdog);
+        {
+            auto rebootCause = RebootCause::Watchdog;
+            const auto pendingReason = consumePendingBootReason();
+            if (pendingReason)
+            {
+                if (const auto* info =
+                        findRebootCauseByPendingReason(*pendingReason))
+                {
+                    rebootCause = info->cause;
+                }
+                else
+                {
+                    error("Invalid reboot cause {CAUSE} in {FILE}", "CAUSE",
+                          *pendingReason, "FILE", pendingBootReasonPath);
+                }
+            }
+            this->lastRebootCause(rebootCause);
             return;
+        }
         default:
+            removePendingBootReason();
             this->lastRebootCause(RebootCause::POR);
             // Continue below to see if more details can be found
             // on reason for reboot
