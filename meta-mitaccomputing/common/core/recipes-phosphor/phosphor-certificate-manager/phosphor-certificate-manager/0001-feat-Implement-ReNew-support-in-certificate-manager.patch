     certParentInstallPath(fs::path(certInstallPath).parent_path())
 {
     try
@@ -433,6 +433,110 @@ void Manager::replaceCertificate(Certificate* const certificate,
     }
 }
 
+std::string Manager::reNew(const std::string certFilePath)
+{
+    std::string currCertFilePath = certFilePath;
+    namespace fs = std::filesystem;
+
+    if (certType == CertificateType::authority)
+    {
+        lg2::error("The type of authority does not support ReNew");
+        return {};
+    }
+    else
+    {
+        if (currCertFilePath.empty())
+        {
+            if (certType == CertificateType::server ||
+                certType == CertificateType::client)
+            {
+                currCertFilePath = certInstallPath;
+            }
+            else
+            {
+                lg2::error("The certificate type does not support ReNew");
+                return {};
+            }
+        }
+    }
+
+    try
+    {
+        lg2::info("Renewing SSL certificate...");
+
+        internal::X509Ptr cert = loadCert(currCertFilePath);
+        std::string certDir = fs::path(currCertFilePath).parent_path().string();
+
+        BIOMemPtr keyBio(BIO_new_file(currCertFilePath.c_str(), "rb"),
+                         ::BIO_free);
+        if (!keyBio)
+        {
+            lg2::error("Unable to open private key file");
+            return {};
+        }
+        EVPPkeyPtr priKey(
+            PEM_read_bio_PrivateKey(keyBio.get(), nullptr, nullptr, nullptr),
+            ::EVP_PKEY_free);
+        if (!priKey)
+        {
+            lg2::error("Unable to load private key");
+            return {};
+        }
+
+        lg2::info("Saving private key to PATH:{PATH}", "PATH",
+                  std::string(certDir + "/privkey.pem").c_str());
+        {
+            BIOMemPtr outBio(
+                BIO_new_file(std::string(certDir + "/privkey.pem").c_str(),
+                             "w"),
+                ::BIO_free);
+            if (!outBio ||
+                !PEM_write_bio_PrivateKey(outBio.get(), priKey.get(), nullptr,
+                                          nullptr, 0, nullptr, nullptr))
+            {
+                lg2::error("Unable to save private key");
+                return {};
+            }
+        }
+
+        X509ReqPtr x509Req(
+            X509_to_X509_REQ(cert.get(), priKey.get(), EVP_sha256()),
+            ::X509_REQ_free);
+        if (!x509Req)
+        {
+            lg2::error("X509_to_X509_REQ conversion error");
+            return {};
+        }
+
+        lg2::info("Saving CSR to PATH:{PATH}", "PATH",
+                  std::string(certDir + "/domain.csr").c_str());
+        {
+            BIOMemPtr csrBio(
+                BIO_new_file(std::string(certDir + "/domain.csr").c_str(), "w"),
+                ::BIO_free);
+            if (!csrBio || !PEM_write_bio_X509_REQ(csrBio.get(), x509Req.get()))
+            {
+                lg2::error("Unable to save CSR");
+                return {};
+            }
+        }
+
+        BIOMemPtr mem(BIO_new(BIO_s_mem()), ::BIO_free);
+        PEM_write_bio_X509_REQ(mem.get(), x509Req.get());
+        BUF_MEM* bptr = nullptr;
+        BIO_get_mem_ptr(mem.get(), &bptr);
+        std::string csrStr(bptr->data, bptr->length);
+
+        return csrStr;
+    }
+    catch (const std::exception& e)
+    {
+        lg2::error("ReNew failed: exception caught - ERROR:{ERROR}", "ERROR",
+                   e.what());
+    }
+    return {};
+}
