From 67851678fc8b800eaba26746453e1206088c0e76 Mon Sep 17 00:00:00 2001
From: Allen Lin <mingchih.lin@mitaccomputing.com>
Date: Tue, 14 Jul 2026 06:45:41 +0000
Subject: [PATCH] [feat] Implement ReNew support in certificate manager

Upstream-Status: Inappropriate [No upstream maintenance]

Summary:
 - Added ReNew method to Cert interface in phosphor-dbus-interfaces.
 - Implemented ReNew function in phosphor-certificate-manager.
 - Private key and CSR are now saved under /etc/ssl/certs/https to allow CA verification against the key.
 - Function returns CSR string for user to submit to CA for signing.

Reference:
 - MBMCS-126 (https://jira.navman.co.nz/jira/browse/MBMCS-126)
---
 certs_manager.cpp | 110 ++++++++++++++++++++++++++++++++++++++++++++--
 certs_manager.hpp |  23 +++++++++-
 2 files changed, 129 insertions(+), 4 deletions(-)

diff --git a/certs_manager.cpp b/certs_manager.cpp
index ea2b55d..f96fdaa 100644
--- a/certs_manager.cpp
+++ b/certs_manager.cpp
@@ -131,9 +131,9 @@ std::vector<std::string> splitCertificates(const std::string& sourceFilePath)
 Manager::Manager(sdbusplus::bus_t& bus, sdeventplus::Event& event,
                  const char* path, CertificateType type,
                  const std::string& unit, const std::string& installPath) :
-    internal::ManagerInterface(bus, path), bus(bus), event(event),
-    objectPath(path), certType(type), unitToRestart(std::move(unit)),
-    certInstallPath(std::move(installPath)),
