index 722f07f..35516fb 100644
--- a/certs_manager.hpp
+++ b/certs_manager.hpp
@@ -16,6 +16,7 @@
 #include <xyz/openbmc_project/Certs/InstallAll/server.hpp>
 #include <xyz/openbmc_project/Certs/ReplaceAll/server.hpp>
 #include <xyz/openbmc_project/Collection/DeleteAll/server.hpp>
+#include <xyz/openbmc_project/Certs/ReNew/server.hpp>
 
 #include <cstdint>
 #include <filesystem>
@@ -23,6 +24,18 @@
 #include <string>
 #include <vector>
 
+// OpenSSL smart pointer typedefs
+// BIO
+using BIOMemPtr = std::unique_ptr<BIO, decltype(&::BIO_free)>;
+// EVP_PKEY
+using EVPPkeyPtr = std::unique_ptr<EVP_PKEY, decltype(&::EVP_PKEY_free)>;
+// X509
+using X509Ptr = std::unique_ptr<X509, decltype(&::X509_free)>;
+// X509_REQ (CSR)
+using X509ReqPtr = std::unique_ptr<X509_REQ, decltype(&::X509_REQ_free)>;
+// BUF_MEM (BIO buffer)
+using BufMemPtr = std::unique_ptr<BUF_MEM, decltype(&::BUF_MEM_free)>;
+
 namespace phosphor::certs
 {
 
@@ -33,7 +46,8 @@ using ManagerInterface = sdbusplus::server::object_t<
     sdbusplus::xyz::openbmc_project::Certs::CSR::server::Create,
     sdbusplus::xyz::openbmc_project::Collection::server::DeleteAll,
     sdbusplus::xyz::openbmc_project::Certs::server::InstallAll,
-    sdbusplus::xyz::openbmc_project::Certs::server::ReplaceAll>;
+    sdbusplus::xyz::openbmc_project::Certs::server::ReplaceAll,
+    sdbusplus::xyz::openbmc_project::Certs::server::ReNew>;
 }
 
 class Manager : public internal::ManagerInterface
@@ -113,6 +127,13 @@ class Manager : public internal::ManagerInterface
     void replaceCertificate(Certificate* const certificate,
                             const std::string& filePath);
 
+    /** @brief Implementation for ReNew
+     *  Renew the certificate using existing key pair.
+     *  @param[in] filePath - Certificate file path.
+     *  @return The PEM-encoded CSR content generated from the certificate.
+     */
+    std::string reNew(const std::string filePath) override;
+
     /** @brief Generate Private key and CSR file
      *  Generates the Private key file and CSR file based on the input
      *  parameters. Validation of the parameters is callers responsibility.
