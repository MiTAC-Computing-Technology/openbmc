+auto GPIODetector::doReactionType()
+    -> sdbusplus::async::task<>
+{
+    // Do ReactionType
+    if (config.reactionType == Detector::ReactionType::ForceOff)
+    {
+        debug("Attempt to Detector::ReactionType::ForceOff");
+        constexpr auto propertyName = "RequestedPowerTransition";
+        constexpr auto interfaceName =
+            "xyz.openbmc_project.State.Chassis";
+        auto chassisSrvProxy =
+            sdbusplus::async::proxy()
+                .service("xyz.openbmc_project.State.Chassis")
+                .path("/xyz/openbmc_project/state/chassis0")
+                .interface(interfaceName);
+        try
+        {
+            co_await chassisSrvProxy.set_property(
+                ctx, propertyName,
+                "xyz.openbmc_project.State.Chassis.Transition.Off");
+
+            std::string severity =
+                (config.level == config::DetectorLevel::critical)
+                    ? "Critical"
+                    : "Warning";
+            const std::string msgId =
+                "MiOBMC.0.1." + severity + "ReactionShutdown";
+            const std::string eventId = severity + "ReactionShutdown";
+            std::string messageArgs = std::format(
+                "{},{},{}", "force off", "LeakDetector", config.name);
+            lg2::warning("'{EVENT}' assert", "EVENT", eventId,
+                         "REDFISH_MESSAGE_ID", msgId,
+                         "REDFISH_MESSAGE_ARGS", messageArgs);
+        }
+        catch (const sdbusplus::exception::SdBusError& e)
+        {
+            error("Exception from sdbusplus: {MSG}", "MSG", e.what());
+        }
+        catch (const std::exception& e)
+        {
+            error("Exception: {MSG}", "MSG", e.what());
+        }
+    }
+    else if (config.reactionType ==
+             Detector::ReactionType::GracefulShutdown)
+    {
+        debug("Attempt to Detector::ReactionType::GracefulShutdown");
+        constexpr auto propertyName = "RequestedHostTransition";
+        constexpr auto interfaceName = "xyz.openbmc_project.State.Host";
+        auto hostSrvProxy =
+            sdbusplus::async::proxy()
+                .service("xyz.openbmc_project.State.Host")
+                .path("/xyz/openbmc_project/state/host0")
+                .interface(interfaceName);
+        try
+        {
+            co_await hostSrvProxy.set_property(
+                ctx, propertyName,
+                "xyz.openbmc_project.State.Host.Transition.Off");
+
+            std::string severity =
+                (config.level == config::DetectorLevel::critical)
+                    ? "Critical"
+                    : "Warning";
+            const std::string msgId =
+                "MiOBMC.0.1." + severity + "ReactionShutdown";
+            const std::string eventId = severity + "ReactionShutdown";
+            std::string messageArgs =
+                std::format("{},{},{}", "graceful shutdown",
+                            "LeakDetector", config.name);
+            lg2::warning("'{EVENT}' assert", "EVENT", eventId,
+                         "REDFISH_MESSAGE_ID", msgId,
+                         "REDFISH_MESSAGE_ARGS", messageArgs);
+        }
+        catch (const sdbusplus::exception::SdBusError& e)
+        {
+            error("Exception from sdbusplus: {MSG}", "MSG", e.what());
+        }
+        catch (const std::exception& e)
+        {
+            error("Exception: {MSG}", "MSG", e.what());
+        }
+    }
+    co_return;
 }
 
