+using json = nlohmann::json;
+namespace fs = std::filesystem;
+
+SettingStorage::SettingStorage(const std::string& path,
+                               const std::string& interface) :
+    _path(path), _interface(interface)
+{
+    fs::path filePath(_path);
+    fs::path parentDir = filePath.parent_path();
+    if (!parentDir.empty() && !fs::exists(parentDir))
+    {
+        fs::create_directories(parentDir);
+    }
+
+    std::ifstream infile(_path);
+    debug("Create config at {PATH}", "PATH", _path);
+    if (!infile.good())
+    {
+        std::ofstream outfile(_path);
+        outfile << "{}" << std::endl;
+    }
+}
+
+std::optional<SettingStorage::PropertyValue> SettingStorage::get_property(
+    const std::string& propName)
+{
+    std::ifstream infile(_path);
+    if (!infile.is_open())
+    {
+        return std::nullopt; // File missing? Return empty optional
+    }
+
+    json data;
+    infile >> data;
+    infile.close();
+
+    if (!data.contains(_interface) || !data[_interface].contains(propName))
+    {
+        return std::nullopt; // Property missing? Return empty optional
+    }
+
+    auto jsonVal = data[_interface][propName];
+
+    if (jsonVal.is_number_integer())
+        return jsonVal.get<int>();
+    if (jsonVal.is_number_float())
+        return jsonVal.get<double>();
+    if (jsonVal.is_boolean())
+        return jsonVal.get<bool>();
+    if (jsonVal.is_string())
+        return jsonVal.get<std::string>();
+
+    return std::nullopt; // Unsupported type
+}
+
+void SettingStorage::set_property(const std::string& propName,
+                                  const PropertyValue& value)
+{
+    constexpr std::size_t jsonIndentSpaces = 4;
+    json data;
+    std::ifstream infile(_path);
+    if (infile.is_open())
+    {
+        infile >> data;
+        infile.close();
+    }
+
+    std::visit([&](const auto& arg) { data[_interface][propName] = arg; },
+               value);
+
+    std::ofstream outfile(_path);
+    if (!outfile.is_open())
+    {
+        throw std::runtime_error("Could not open settings file for writing.");
+    }
+
+    outfile << data.dump(jsonIndentSpaces);
+    outfile.close();
+}
