+auto GPIODetector::monitorPropertyChange() -> sdbusplus::async::task<>
+{
+    auto localMatchRule = sdbusplus::bus::match::rules::propertiesChanged(
+        "/xyz/openbmc_project/state/leak/detector/" +
+            config.name, // Your active state object
+        "xyz.openbmc_project.State.Leak.Detector");
+    sdbusplus::async::match localMatcher(ctx, localMatchRule);
+
+    // Setup a concurrent execution pipeline or loop using select/next hooks
+    while (true)
+    {
+        // For simplicity in a single flow, let's process updates coming from
+        // the local state matcher
+        auto [interfaceName, changedProperties, invalidatedProperties] =
+            co_await localMatcher.next<
+                std::string, std::map<std::string, std::variant<std::string>>,
+                std::vector<std::string>>();
+
+        // Process WarningReactionType changes
+        auto warnIt = changedProperties.find("WarningReactionType");
+        if (warnIt != changedProperties.end())
+        {
+            if (auto valPtr = std::get_if<std::string>(&warnIt->second))
             {
-                if (config.level == level)
+                settingStorage.set_property("WarningReactionType", *valPtr);
+                if (config.level == config::DetectorLevel::warning)
                 {
-                    auto target = std::string(serviceSuffix) + config.name +
-                                  ".service";
-                    debug("Starting systemd target {TARGET}", "TARGET", target);
-                    co_await systemd::SystemdInterface::startUnit(ctx, target);
-                    break;
+                    config.reactionType =
+                        Detector::convertReactionTypeFromString(*valPtr);
                 }
             }
         }
-    }
 
-    co_return;
+        // Process CriticalReactionType changes
+        auto critIt = changedProperties.find("CriticalReactionType");
+        if (critIt != changedProperties.end())
+        {
+            if (auto valPtr = std::get_if<std::string>(&critIt->second))
+            {
+                settingStorage.set_property("CriticalReactionType", *valPtr);
+                if (config.level == config::DetectorLevel::critical)
+                {
+                    config.reactionType =
+                        Detector::convertReactionTypeFromString(*valPtr);
+                }
+            }
+        }
+    }
 }
