+auto GPIODetector::setFruFaultLED(bool active)
+    -> sdbusplus::async::task<>
+{
+    const std::string LedPath =
+        "/xyz/openbmc_project/led/groups/" +
+        ((config.LED == "") ? LEAK_DETECTOR_FAULT_GROUP_LED : config.LED);
+    auto ledMgrProxy = sdbusplus::async::proxy()
+                           .service("xyz.openbmc_project.LED.GroupManager")
+                           .path(LedPath)
+                           .interface("org.freedesktop.DBus.Properties");
+    try
+    {
+        info("Turned {LED} On", "LED", LedPath);
+        co_await ledMgrProxy.call<>(
+            ctx, "Set", "xyz.openbmc_project.Led.Group", "Asserted",
+            std::variant<bool>{active});
+    }
+    catch (const sdbusplus::exception::SdBusError& e)
+    {
+        error("Exception from sdbusplus: {MSG}", "MSG", e.what());
+    }
+    catch (const std::exception& e)
+    {
+        error("Exception: {MSG}", "MSG", e.what());
+    }
+    co_return;
+}
