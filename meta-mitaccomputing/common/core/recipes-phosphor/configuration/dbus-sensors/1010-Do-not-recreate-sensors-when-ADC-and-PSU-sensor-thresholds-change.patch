                 if (findCPU != baseConfiguration->second.end())
                 {
@@ -264,7 +241,6 @@ void createSensors(
                 PowerState readState = getPowerState(baseConfiguration->second);
 
                 auto& sensor = sensors[sensorName];
-                sensor = nullptr;
 
                 std::optional<BridgeGpio> bridgeGpio;
                 for (const auto& [key, cfgMap] : *sensorData)
@@ -305,6 +281,76 @@ void createSensors(
                     }
                 }
 
+                // on rescans, only update sensors we were signaled by
+                auto findSensor = sensors.find(sensorName);
+                if (!firstScan && findSensor != sensors.end())
+                {
+                    bool found = false;
+                    for (auto it = sensorsChanged->begin();
+                         it != sensorsChanged->end(); it++)
+                    {
+                        if (findSensor->second &&
+                            it->ends_with(findSensor->second->name))
+                        {
+                            sensorsChanged->erase(it);
+                            if (findSensor->second->requiresRecreation(
+                                    scaleFactor, pollRate, readState,
+                                    bridgeGpio, sensorThresholds))
+                            {
+                                findSensor->second = nullptr;
+                                found = true;
+                            }
+                            else
+                            {
+                                for (const auto& newThreshold :
+                                     sensorThresholds)
+                                {
+                                    for (auto& oldThreshold :
+                                         findSensor->second->thresholds)
+                                    {
+                                        if (oldThreshold.level ==
+                                                newThreshold.level &&
+                                            oldThreshold.direction ==
+                                                newThreshold.direction)
+                                        {
+                                            oldThreshold.value =
+                                                newThreshold.value;
+                                            if (!std::isnan(
+                                                    newThreshold.hysteresis))
+                                            {
+                                                oldThreshold.hysteresis =
+                                                    newThreshold.hysteresis;
+                                            }
+                                            else
+                                            {
+                                                oldThreshold.hysteresis =
+                                                    findSensor->second
+                                                        ->hysteresisTrigger;
+                                            }
+                                            break;
+                                        }
+                                    }
+                                }
+                                thresholds::updateThresholds(
+                                    findSensor->second.get());
+                                findSensor->second->value =
+                                    std::numeric_limits<double>::quiet_NaN();
+                                found = false;
+                            }
+                            break;
+                        }
+                    }
+                    if (!found)
+                    {
+                        continue;
+                    }
+                }
+
+                if (sensor)
+                {
+                    sensor = nullptr;
+                }
+
                 sensor = std::make_shared<ADCSensor>(
                     path.string(), objectServer, dbusConnection, io, sensorName,
                     std::move(sensorThresholds), scaleFactor, pollRate,
