From ab9660f1fee90ade0f2273d4cad49f78be8044cb Mon Sep 17 00:00:00 2001
From: "justin.kuo" <justin.kuo@mitaccomputing.com>
Date: Thu, 30 Jul 2026 01:39:41 +0000
Subject: [PATCH] Do not recreate the sensors when the ADC and PSU sensor
 thresholds change.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 src/adc/ADCSensor.cpp     | 81 ++++++++++++++++++++++++++++++++-
 src/adc/ADCSensor.hpp     |  4 ++
 src/adc/ADCSensorMain.cpp | 94 +++++++++++++++++++++++++++++----------
 src/psu/PSUSensor.cpp     | 82 +++++++++++++++++++++++++++++++++-
 src/psu/PSUSensor.hpp     |  7 ++-
 src/psu/PSUSensorMain.cpp | 45 +++++++++++++++++--
 6 files changed, 282 insertions(+), 31 deletions(-)

diff --git a/src/adc/ADCSensor.cpp b/src/adc/ADCSensor.cpp
index cbf7132..452ce27 100644
--- a/src/adc/ADCSensor.cpp
+++ b/src/adc/ADCSensor.cpp
@@ -258,5 +258,84 @@ void ADCSensor::checkThresholds()
         return;
     }
 
-    thresholds::checkThresholdsPowerDelay(weak_from_this(), thresholdTimer);
+    if (readState == PowerState::always)
+    {
+        thresholds::checkThresholds(this);
+    }
+    else
+    {
+        thresholds::checkThresholdsPowerDelay(weak_from_this(), thresholdTimer);
+    }
+}
+
+bool ADCSensor::requiresRecreation(
+    double newScaleFactor, float newPollRate, PowerState newReadState,
+    const std::optional<BridgeGpio>& newBridgeGpio,
+    const std::vector<thresholds::Threshold>& newThresholds) const
+{
+    if (scaleFactor != newScaleFactor)
+    {
+        return true;
+    }
+    if (sensorPollMs != static_cast<unsigned int>(newPollRate * 1000))
+    {
+        return true;
+    }
+    if (readState != newReadState)
+    {
+        return true;
+    }
+    if (bridgeGpio.has_value() != newBridgeGpio.has_value())
+    {
+        return true;
+    }
+    if (bridgeGpio.has_value() && newBridgeGpio.has_value())
+    {
+        if (bridgeGpio->setupTimeMs != newBridgeGpio->setupTimeMs)
+        {
+            return true;
+        }
+    }
+
+    // Check if threshold structure changed (i.e. levels or directions
+    // added/removed)
+    size_t configuredCount = 0;
+    for (const auto& th : thresholds)
+    {
+        if (!std::isnan(th.value))
+        {
+            configuredCount++;
+        }
+    }
+    size_t newConfiguredCount = 0;
+    for (const auto& th : newThresholds)
+    {
+        if (!std::isnan(th.value))
+        {
+            newConfiguredCount++;
+        }
+    }
+    if (configuredCount != newConfiguredCount)
+    {
+        return true;
+    }
+    for (const auto& newThreshold : newThresholds)
+    {
+        if (std::isnan(newThreshold.value))
+        {
+            continue;
+        }
+        auto it = std::find_if(
+            thresholds.begin(), thresholds.end(),
+            [&newThreshold](const thresholds::Threshold& oldThreshold) {
+                return oldThreshold.level == newThreshold.level &&
+                       oldThreshold.direction == newThreshold.direction;
+            });
+        if (it == thresholds.end())
+        {
+            return true;
+        }
+    }
+
+    return false;
 }
