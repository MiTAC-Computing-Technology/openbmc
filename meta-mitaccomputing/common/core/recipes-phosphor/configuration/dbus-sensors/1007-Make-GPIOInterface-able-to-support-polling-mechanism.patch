From 0595c94a31ea39481cfbc0d128ea7c5db4233c68 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Wed, 17 Jun 2026 10:55:33 +0000
Subject: [PATCH 1/2] Make GPIOInterface able to support polling mechanism for
 GPIO expanders without IRQ.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 src/GPIOInterface.cpp | 140 ++++++++++++++++++++++++++++++++----------
 src/GPIOInterface.hpp |  14 ++++-
 2 files changed, 122 insertions(+), 32 deletions(-)

diff --git a/src/GPIOInterface.cpp b/src/GPIOInterface.cpp
index 0bd0f4c..2badb52 100644
--- a/src/GPIOInterface.cpp
+++ b/src/GPIOInterface.cpp
@@ -1,9 +1,13 @@
 #include "GPIOInterface.hpp"
 
+#include <sys/timerfd.h>
+#include <unistd.h>
+
 #include <gpiod.hpp>
 #include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/async.hpp>
 
+#include <cstring>
 #include <exception>
 #include <memory>
 #include <stdexcept>
@@ -15,41 +19,91 @@ namespace gpio
 
 PHOSPHOR_LOG2_USING;
 
-GPIOInterface::GPIOInterface(sdbusplus::async::context& ctx,
-                             const std::string& consumerName,
-                             const std::string& pinName, bool activeLow,
-                             Callback_t updateStateCallback) :
-    ctx(ctx), pinName(pinName),
-    updateStateCallback(std::move(updateStateCallback))
+GPIOInterface::GPIOInterface(
+    sdbusplus::async::context& ctx, const std::string& consumerName,
+    const std::string& pinName, bool activeLow, GPIO_DETECTION detection,
+    Callback_t updateStateCallback) :
+    ctx(ctx), pinName(pinName), detection(detection),
+    updateStateCallback(std::move(updateStateCallback)),
+    gpio_detect(GPIO_DETECTION::eventing), timerFd(-1), lastReading(0)
 {
     if (!this->updateStateCallback)
     {
         throw std::runtime_error("updateStateCallback is not set");
     }
-    line = gpiod::find_line(pinName);
-    if (!line)
-    {
-        throw std::runtime_error("Failed to find GPIO line for " + pinName);
-    }
-    try
-    {
-        line.request({consumerName, gpiod::line_request::EVENT_BOTH_EDGES,
-                      activeLow ? gpiod::line_request::FLAG_ACTIVE_LOW : 0});
-    }
-    catch (std::exception& e)
+
+    if (detection == GPIO_DETECTION::polling)
     {
-        throw std::runtime_error("Failed to request line for " + pinName +
-                                 " with error " + e.what());
+        gpio_detect = GPIO_DETECTION::polling;
+        line = gpiod::find_line(pinName);
+        if (!line)
+        {
+            throw std::runtime_error("Failed to find GPIO line for " + pinName);
+        }
+        try
+        {
+            line.request(
+                {consumerName, gpiod::line_request::DIRECTION_INPUT,
+                 activeLow ? gpiod::line_request::FLAG_ACTIVE_LOW : 0});
+        }
+        catch (std::exception& e)
+        {
+            throw std::runtime_error("Failed to request line for " + pinName +
+                                     " with error " + e.what());
+        }
+
+        timerFd = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
+        if (timerFd < 0)
+        {
+            throw std::runtime_error(
+                "Failed to create timerfd: " + std::string(strerror(errno)));
+        }
+
+        struct itimerspec timerSpec;
+        std::memset(&timerSpec, 0, sizeof(timerSpec));
+
+        // Hardcode to 1sec polling interval.
+        timerSpec.it_interval.tv_sec = 1;
+        timerSpec.it_interval.tv_nsec = 1;
+        timerSpec.it_value.tv_sec = 1;
+        timerSpec.it_value.tv_nsec = 0;
+
+        if (timerfd_settime(timerFd, 0, &timerSpec, nullptr) < 0)
+        {
+            close(timerFd);
+            throw std::runtime_error(
+                "Failed to set timerfd time: " + std::string(strerror(errno)));
+        }
+        fdioInstance = std::make_unique<sdbusplus::async::fdio>(ctx, timerFd);
     }
-
-    int lineFd = line.event_get_fd();
-    if (lineFd < 0)
+    else
     {
-        throw std::runtime_error(
-            "Failed to get event fd for GPIO line " + pinName);
+        gpio_detect = GPIO_DETECTION::eventing;
+        line = gpiod::find_line(pinName);
+        if (!line)
+        {
+            throw std::runtime_error("Failed to find GPIO line for " + pinName);
+        }
+        try
+        {
+            line.request(
+                {consumerName, gpiod::line_request::EVENT_BOTH_EDGES,
+                 activeLow ? gpiod::line_request::FLAG_ACTIVE_LOW : 0});
+        }
+        catch (std::exception& e)
+        {
+            throw std::runtime_error("Failed to request line for " + pinName +
+                                     " with error " + e.what());
+        }
+        int lineFd = line.event_get_fd();
+        if (lineFd < 0)
+        {
+            throw std::runtime_error(
+                "Failed to get event fd for GPIO line " + pinName);
+        }
+
+        fdioInstance = std::make_unique<sdbusplus::async::fdio>(ctx, lineFd);
     }
-
-    fdioInstance = std::make_unique<sdbusplus::async::fdio>(ctx, lineFd);
 }
 
 auto GPIOInterface::start() -> sdbusplus::async::task<>
@@ -81,11 +135,35 @@ auto GPIOInterface::readGPIOAsyncEvent() -> sdbusplus::async::task<>
         // Wait for the fd event for the line to change
         co_await fdioInstance->next();
 
-        line.event_read();
-        auto lineValue = line.get_value();
-
-        co_await updateStateCallback(
-            lineValue == gpiod::line_event::RISING_EDGE);
+        if (gpio_detect == GPIO_DETECTION::eventing)
+        {
+            line.event_read();
+            auto lineValue = line.get_value();
+            co_await updateStateCallback(
+                lineValue == gpiod::line_event::RISING_EDGE);
+        }
+        else if (gpio_detect == GPIO_DETECTION::polling)
+        {
+            uint64_t expirations = 0;
+            ssize_t bytesRead =
+                read(this->timerFd, &expirations, sizeof(expirations));
+
+            if (bytesRead < 0)
+            {
+                if (errno == EAGAIN || errno == EWOULDBLOCK)
+                {
+                    continue; // Spurious wakeup, try again
+                }
+                // Handle actual read error here
+                break;
+            }
+            auto lineValue = line.get_value();
+            if (lineValue != lastReading)
+            {
+                lastReading = lineValue;
+                co_await updateStateCallback(lineValue == 1);
+            }
+        }
     }
 
     co_return;
diff --git a/src/GPIOInterface.hpp b/src/GPIOInterface.hpp
index b860551..37a2089 100644
--- a/src/GPIOInterface.hpp
+++ b/src/GPIOInterface.hpp
@@ -10,6 +10,13 @@
 namespace gpio
 {
 
+/** @brief GPIO polarity */
+enum class GPIO_DETECTION
+{
+    eventing,
+    polling,
+};
+
 class GPIOInterface
 {
   public:
@@ -19,7 +26,8 @@ class GPIOInterface
 
     GPIOInterface(sdbusplus::async::context& ctx,
                   const std::string& consumerName, const std::string& pinName,
-                  bool activeLow, Callback_t updateStateCallback);
+                  bool activeLow, GPIO_DETECTION detection,
+                  Callback_t updateStateCallback);
 
     /** @brief Start the GPIO Interface */
     auto start() -> sdbusplus::async::task<>;
@@ -33,8 +41,12 @@ class GPIOInterface
 
     sdbusplus::async::context& ctx;
     const std::string& pinName;
+    GPIO_DETECTION detection;
     Callback_t updateStateCallback;
     gpiod::line line;
+    GPIO_DETECTION gpio_detect;
+    int timerFd;
+    int lastReading;
     /** File descriptor based async event handler */
     std::unique_ptr<sdbusplus::async::fdio> fdioInstance;
 };
-- 
2.43.0

