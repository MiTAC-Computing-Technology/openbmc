 #include <phosphor-logging/elog-errors.hpp>
 #include <phosphor-logging/elog.hpp>
 #include <phosphor-logging/lg2.hpp>
@@ -16,13 +14,12 @@
 #include <xyz/openbmc_project/Software/Version/error.hpp>
 
 #include <fstream>
+#include <utility>
 
 #ifdef WANT_SIGNATURE_VERIFY
 #include "image_verify.hpp"
 #endif
 
-extern boost::asio::io_context& getIOContext();
-
 namespace phosphor
 {
 namespace software
@@ -129,6 +126,26 @@ void Activation::redfishLog(const std::string& id, const std::string& message,
     redfish::firmwareUpdate(id, target, version, message);
 }
 
+void Activation::scheduleUploadActivationCleanup()
+{
+    auto id = versionId;
+    auto& itemUpdater = parent;
+
+    ctx.spawn([](auto& parent, auto id) -> sdbusplus::async::task<> {
+        parent.erase(id);
+        co_return;
+    }(itemUpdater, std::move(id)));
+}
+
+auto Activation::setFailedAndCleanupUpload() -> Activations
+{
+    auto failedState =
+        Activation::activation(softwareServer::Activation::Activations::Failed);
+    scheduleUploadActivationCleanup();
+
+    return failedState;
+}
+
 auto Activation::activation(Activations value) -> Activations
 {
     if ((value != softwareServer::Activation::Activations::Active) &&
@@ -160,8 +177,7 @@ auto Activation::activation(Activations value) -> Activations
         if (!minimum_ship_level::verify(versionStr))
         {
             redfishLog("FirmwareUpdateFailed", "Version too low to update");
-            return softwareServer::Activation::activation(
-                softwareServer::Activation::Activations::Failed);
+            return setFailedAndCleanupUpload();
         }
 
         if (!activationProgress)
@@ -174,8 +190,7 @@ auto Activation::activation(Activations value) -> Activations
         {
             redfishLog("FirmwareUpdateFailed",
                        "A firmware update is in progress");
-            return softwareServer::Activation::activation(
-                softwareServer::Activation::Activations::Failed);
+            return setFailedAndCleanupUpload();
         }
 
         if (!activationBlocksTransition)
@@ -511,18 +526,14 @@ void Activation::onStateChangesBios(sdbusplus::message_t& msg)
             parent.biosVersion->version(
                 parent.versions.find(versionId)->second->version());
 
-            // Delete the uploaded activation
-            boost::asio::post(getIOContext(), [this]() {
-                this->parent.erase(this->versionId);
-            });
+            scheduleUploadActivationCleanup();
         }
         else if (newStateResult == "failed")
         {
-            // Set Activation value to Failed
-            activation(softwareServer::Activation::Activations::Failed);
-
             error("Bios upgrade failed.");
             redfishLog("FirmwareUpdateFailed", "Firmware update failed");
+
+            setFailedAndCleanupUpload();
         }
     }
 
