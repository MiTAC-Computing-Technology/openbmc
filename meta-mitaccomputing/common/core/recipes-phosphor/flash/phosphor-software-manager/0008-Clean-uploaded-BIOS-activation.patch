 bmc/activation.hpp     | 23 +++++++++++++++++++----
 bmc/item_updater.cpp   | 17 +++++++++++++----
 bmc/software_utils.cpp |  9 +++------
 bmc/software_utils.hpp |  4 ----
 5 files changed, 61 insertions(+), 33 deletions(-)

