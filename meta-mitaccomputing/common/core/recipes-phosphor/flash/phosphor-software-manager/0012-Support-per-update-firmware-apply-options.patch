@@ -215,8 +238,18 @@ class Activation : public ActivationInherit, public Flash
         activation(activationStatus);
         associations(assocs);
 
-        // Emit deferred signal.
+        // Emit the Activation object's deferred signal before adding the
+        // optional per-upload interface.
         emit_object_added();
+
+        if (createApplyOptions)
+        {
+            applyOptions = std::make_unique<ApplyOptions>(bus, path);
+            if (clearConfig.has_value())
+            {
+                applyOptions->clearConfig(*clearConfig);
+            }
+        }
     }
 
