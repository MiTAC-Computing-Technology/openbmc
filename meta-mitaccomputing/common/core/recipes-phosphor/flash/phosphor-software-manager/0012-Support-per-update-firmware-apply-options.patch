+/** @class ApplyOptions
+ *  @brief Per-upload firmware apply options implementation.
+ *  @details Implements xyz.openbmc_project.Software.ApplyOptions for the
+ *  lifetime of an uploaded firmware Activation object.
+ */
+class ApplyOptions : public ApplyOptionsInherit
+{
+  public:
+    /** @brief Constructs ApplyOptions on an uploaded image object. */
+    ApplyOptions(sdbusplus::bus_t& bus, const std::string& path) :
+        ApplyOptionsInherit(bus, path.c_str(), action::emit_interface_added)
+    {}
+};
+
