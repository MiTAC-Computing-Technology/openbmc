+                                              clearConfig);
 
     int newFd = dup(image);
     ctx.spawn(processImage(newFd, applyTime, id, objPath));
@@ -268,4 +277,27 @@ sdbusplus::message::object_path Manager::startUpdate(
     return sdbusplus::message::object_path(objPath);
 }
 
+sdbusplus::message::object_path Manager::startUpdateOptions(
+    sdbusplus::message::unix_fd image,
+    ApplyTimeIntf::RequestedApplyTimes applyTime, UpdateOptions options)
+{
+    std::optional<bool> clearConfig;
+    auto option = options.find("ResetSettingsToDefault");
+    if (option != options.end())
+    {
+        if (const auto* value = std::get_if<bool>(&option->second))
+        {
+            clearConfig = *value;
+            info("ResetSettingsToDefault is {CLEAR_CONFIG}", "CLEAR_CONFIG",
+                 *value);
+        }
+        else
+        {
+            error("ResetSettingsToDefault option must be a boolean");
+        }
+    }
+
+    return startUpdateImpl(image, applyTime, clearConfig);
+}
+
 } // namespace phosphor::software::update
