@@ -0,0 +1,41 @@
+#pragma once
+
+#include <phosphor-logging/lg2.hpp>
+
+#include <format>
+#include <string>
+
+namespace phosphor::software::redfish
+{
+
+inline void firmwareUpdate(const std::string& id, const std::string& target,
+                           const std::string& version,
+                           const std::string& message)
+{
+    std::string msgId = "OpenBMC.0.5." + id;
+    std::string msgArgs;
+
+    if (id == "FirmwareUpdateFailed")
+    {
+        msgArgs = std::format("{},{},{}", target, version, message);
+    }
+    else if (id == "FirmwareUpdateStarted" || id == "FirmwareUpdateCompleted")
+    {
+        msgArgs = std::format("{},{}", target, version);
+    }
+    else if (id == "BMCBootReason")
+    {
+        msgArgs = std::format("{},{}", version, message);
+    }
+    lg2::info("{LOG_MSG}", "LOG_MSG", message, "REDFISH_MESSAGE_ID", msgId,
+              "REDFISH_MESSAGE_ARGS", msgArgs);
+}
+
+inline void firmwareUpdateFailed(const std::string& target,
+                                 const std::string& version,
+                                 const std::string& message)
+{
+    firmwareUpdate("FirmwareUpdateFailed", target, version, message);
+}
+
+} // namespace phosphor::software::redfish
