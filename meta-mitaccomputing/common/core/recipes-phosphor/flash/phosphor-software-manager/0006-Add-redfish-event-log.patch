+void Activation::redfishLog(const std::string& id, const std::string& message,
+                            const bool isBmcReboot)
+{
+    auto version = parent.versions.find(versionId)->second->version();
+    auto purpose = parent.versions.find(versionId)->second->purpose();
+
+    std::string target;
+    if (purpose == VersionPurpose::BMC)
+    {
+        target = "BMC";
+    }
+    else if (purpose == VersionPurpose::Host)
+    {
+        target = "BIOS";
+    }
+    else
+    {
+        target = "Unknown";
+    }
+
+    if (isBmcReboot)
+    {
+        constexpr auto bmcFirmwareUpdateInprogress =
+            "/var/log/bmcFirmwareUpdateInprogress";
+        std::ofstream versionFile(bmcFirmwareUpdateInprogress,
+                                  std::ios::out | std::ios::trunc);
+        if (!versionFile)
+        {
+            error("Failed to open {PATH}", "PATH", bmcFirmwareUpdateInprogress);
+        }
+        else
+        {
+            versionFile << version;
+            if (!versionFile)
+            {
+                error("Failed to write {PATH}", "PATH",
+                      bmcFirmwareUpdateInprogress);
+            }
+        }
+        version = phosphor::software::manager::Version::getBMCVersion(
+            OS_RELEASE_FILE);
+    }
+
+    redfish::firmwareUpdate(id, target, version, message);
+}
