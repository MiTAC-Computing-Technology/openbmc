+void ItemUpdater::updateBmcPendingRedfishLog()
+{
+    static constexpr auto updateFinishFile = "/var/log/bmcFirmwareUpdateFinish";
+
+    if (!fs::exists(updateFinishFile))
+    {
+        return;
+    }
+
+    std::ifstream updateFinish(updateFinishFile);
+    std::string version;
+    std::string result;
+
+    std::getline(updateFinish, version, ',');
+    std::getline(updateFinish, result);
+
+    if (result == "Firmware update successful")
+    {
+        redfish::firmwareUpdate("FirmwareUpdateCompleted", "BMC", version,
+                                result);
+    }
+    else
+    {
+        redfish::firmwareUpdate("FirmwareUpdateFailed", "BMC", version, result);
+    }
+
+    std::error_code ec;
+    fs::remove(updateFinishFile, ec);
+    if (ec)
+    {
+        error("Failed to remove {PATH}: {ERROR}", "PATH", updateFinishFile,
+              "ERROR", ec.message());
+    }
+}
