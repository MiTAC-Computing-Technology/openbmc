+#include <system_error>
+
+PHOSPHOR_LOG2_USING;
+
+namespace phosphor::software::cpld
+{
+
+namespace fs = std::filesystem;
+using namespace std::chrono_literals;
+
+constexpr std::array<std::string_view, 3> guardedTargets = {
+    "reboot", "poweroff", "halt"};
+constexpr const char systemdRuntimeRoot[] = "/run/systemd/system";
+constexpr std::string_view guardFileName = "cpld-update-reboot-guard.conf";
+constexpr std::string_view guardContents = "[Unit]\nRefuseManualStart=yes\n";
+constexpr size_t removeMaxAttempts = 3;
+constexpr auto removeRetryInterval = 100ms;
+
+CPLDRebootGuard::CPLDRebootGuard(sdbusplus::async::context& ctx) : ctx(ctx) {}
+
+sdbusplus::async::task<> CPLDRebootGuard::waitForTransition()
+{
+    while (transitionInProgress)
+    {
+        co_await sdbusplus::async::sleep_for(ctx, 10ms);
+    }
+}
+
+bool CPLDRebootGuard::createGuardFiles()
+{
+    for (const std::string_view target : guardedTargets)
+    {
+        const fs::path directory =
+            fs::path(systemdRuntimeRoot) / (std::string(target) + ".target.d");
+        std::error_code ec;
+        fs::create_directories(directory, ec);
+        if (ec)
+        {
+            error(
+                "Failed to create CPLD reboot guard directory {PATH}: {ERROR}",
+                "PATH", directory.string(), "ERROR", ec.message());
+            return false;
+        }
+
+        const fs::path guardPath = directory / guardFileName;
+        std::ofstream guardFile(guardPath, std::ios::out | std::ios::trunc);
+        if (!guardFile.is_open())
+        {
+            error("Failed to create CPLD reboot guard file {PATH}", "PATH",
+                  guardPath.string());
+            return false;
+        }
+
+        guardFile << guardContents;
+        if (!guardFile.good())
+        {
+            error("Failed to write CPLD reboot guard file {PATH}", "PATH",
+                  guardPath.string());
+            guardFile.close();
+            return false;
+        }
+    }
+
+    return true;
+}
+
+sdbusplus::async::task<CPLDRebootGuard::RemoveGuardResult>
+    CPLDRebootGuard::removeGuardFiles()
+{
+    RemoveGuardResult result;
+
+    for (size_t attempt = 1; attempt <= removeMaxAttempts; ++attempt)
+    {
+        bool allRemoved = true;
+
+        for (const std::string_view target : guardedTargets)
+        {
+            const fs::path guardPath =
+                fs::path(systemdRuntimeRoot) /
+                (std::string(target) + ".target.d") / guardFileName;
+            std::error_code ec;
+            const bool removed = fs::remove(guardPath, ec);
+            result.removedAny = result.removedAny || removed;
+
+            if (ec)
+            {
+                allRemoved = false;
+                if (attempt < removeMaxAttempts)
+                {
+                    warning(
+                        "Failed to remove CPLD reboot guard file {PATH} on attempt {ATTEMPT}/{MAX_ATTEMPTS}: {ERROR}",
+                        "PATH", guardPath.string(), "ATTEMPT", attempt,
+                        "MAX_ATTEMPTS", removeMaxAttempts, "ERROR",
+                        ec.message());
+                }
+                else
+                {
+                    error(
+                        "Failed to remove CPLD reboot guard file {PATH} after {MAX_ATTEMPTS} attempts: {ERROR}",
+                        "PATH", guardPath.string(), "MAX_ATTEMPTS",
+                        removeMaxAttempts, "ERROR", ec.message());
+                }
+            }
+        }
+
+        if (allRemoved)
+        {
+            result.allRemoved = true;
+            co_return result;
+        }
+
+        if (attempt < removeMaxAttempts)
+        {
+            co_await sdbusplus::async::sleep_for(ctx, removeRetryInterval);
+        }
+    }
+
+    co_return result;
+}
+
+sdbusplus::async::task<bool> CPLDRebootGuard::reloadSystemd()
+{
+    auto systemd = sdbusplus::async::proxy()
+                       .service("org.freedesktop.systemd1")
+                       .path("/org/freedesktop/systemd1")
+                       .interface("org.freedesktop.systemd1.Manager");
+
+    try
+    {
+        co_await systemd.call<>(ctx, "Reload");
+    }
+    catch (const std::exception& e)
+    {
+        error("Failed to reload systemd for CPLD reboot guard: {ERROR}",
+              "ERROR", e.what());
+        co_return false;
+    }
+
+    co_return true;
+}
+
+sdbusplus::async::task<CPLDRebootGuard::GuardState>
+    CPLDRebootGuard::rollbackGuard()
+{
+    const auto removal = co_await removeGuardFiles();
+    if (!removal.allRemoved)
+    {
+        error("Failed to roll back incomplete CPLD reboot guard files");
+        co_return (co_await restoreGuard())
+            ? GuardState::active
+            : GuardState::unknown;
+    }
+
+    if (!(co_await reloadSystemd()))
+    {
+        error("Failed to reload systemd after rolling back CPLD reboot guard");
+        co_return (co_await restoreGuard())
+            ? GuardState::active
+            : GuardState::unknown;
+    }
+
+    co_return GuardState::inactive;
+}
+
+sdbusplus::async::task<CPLDRebootGuard::GuardState>
+    CPLDRebootGuard::enableGuard()
+{
+    if (!createGuardFiles())
+    {
+        error("Failed to create all CPLD reboot guard files; rolling back");
+        co_return co_await rollbackGuard();
+    }
+
+    if (!(co_await reloadSystemd()))
+    {
+        error("Failed to enable CPLD reboot guard; rolling back guard files");
+        co_return co_await rollbackGuard();
+    }
+
+    info("CPLD firmware update started; manual BMC transitions are disabled");
+    co_return GuardState::active;
+}
+
+sdbusplus::async::task<bool> CPLDRebootGuard::restoreGuard()
+{
+    if (!createGuardFiles())
+    {
+        error("Failed to restore all CPLD reboot guard files");
+        co_return false;
+    }
+
+    if (!(co_await reloadSystemd()))
+    {
+        error("Failed to reload systemd after restoring CPLD reboot guard");
+        co_return false;
+    }
+
+    warning("CPLD reboot guard remains enabled after cleanup failure");
+    co_return true;
+}
+
+sdbusplus::async::task<CPLDRebootGuard::GuardState>
+    CPLDRebootGuard::disableGuard()
+{
+    const auto removal = co_await removeGuardFiles();
+    if (!removal.allRemoved)
+    {
+        error("Failed to remove all CPLD reboot guard files");
+        co_return (co_await restoreGuard())
+            ? GuardState::active
+            : GuardState::unknown;
+    }
+
+    if (!(co_await reloadSystemd()))
+    {
+        error("Failed to reload systemd after removing CPLD reboot guard");
+        co_return (co_await restoreGuard())
+            ? GuardState::active
+            : GuardState::unknown;
+    }
+
+    info("CPLD firmware updates ended; manual BMC transitions are enabled");
+    co_return GuardState::inactive;
+}
+
+sdbusplus::async::task<bool> CPLDRebootGuard::acquire()
+{
+    co_await waitForTransition();
+    transitionInProgress = true;
+
+    if (activeUsers == 0 || guardState != GuardState::active)
+    {
+        guardState = co_await enableGuard();
+    }
+
+    ++activeUsers;
+    transitionInProgress = false;
+    co_return guardState == GuardState::active;
+}
+
+sdbusplus::async::task<> CPLDRebootGuard::release()
+{
+    co_await waitForTransition();
+    transitionInProgress = true;
+
+    if (activeUsers == 0)
+    {
+        warning("Ignoring release of an inactive CPLD reboot guard");
+        transitionInProgress = false;
+        co_return;
+    }
+
+    --activeUsers;
+    if (activeUsers == 0)
+    {
+        guardState = co_await disableGuard();
+    }
+
+    transitionInProgress = false;
+}
+
+sdbusplus::async::task<> CPLDRebootGuard::cleanupStaleGuard()
+{
+    co_await waitForTransition();
+    transitionInProgress = true;
+
+    activeUsers = 0;
+    const auto removal = co_await removeGuardFiles();
+    if (!removal.allRemoved)
+    {
+        error("Failed to remove all stale CPLD reboot guard files");
+        guardState = GuardState::unknown;
+        transitionInProgress = false;
+        co_return;
+    }
+
+    if (!(co_await reloadSystemd()))
+    {
+        error(
+            "Failed to reload systemd after removing stale CPLD reboot guard");
+        guardState = GuardState::unknown;
+        transitionInProgress = false;
+        co_return;
+    }
+
+    guardState = GuardState::inactive;
+    if (removal.removedAny)
+    {
+        warning("Removed stale CPLD reboot guard from a previous daemon run");
+    }
+
+    transitionInProgress = false;
+}
+
+} // namespace phosphor::software::cpld
