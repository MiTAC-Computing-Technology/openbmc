+void Device::redfishLog(const std::string& id, const std::string& target,
+                        const std::string& version, const std::string& message)
+{
+    std::string msgId = "OpenBMC.0.5." + id;
+    std::string msgArgs;
+
+    if (id == "FirmwareUpdateFailed")
+    {
+        msgArgs = std::format("{},{},{}", target, version, message);
+    }
+    else if (id == "FirmwareUpdateStarted" || id == "FirmwareUpdateCompleted")
+    {
+        msgArgs = std::format("{},{}", target, version);
+    }
+    lg2::info("{LOG_MSG}", "LOG_MSG", message, "REDFISH_MESSAGE_ID", msgId,
+              "REDFISH_MESSAGE_ARGS", msgArgs);
+}
+
 // NOLINTBEGIN(readability-static-accessed-through-instance)
