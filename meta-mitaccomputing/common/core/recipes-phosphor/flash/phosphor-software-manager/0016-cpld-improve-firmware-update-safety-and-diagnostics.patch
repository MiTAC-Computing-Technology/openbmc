+sdbusplus::async::task<std::optional<uint64_t>>
+    CPLDSoftwareManager::getBusNoFromMuxChannel(const std::string& service,
+                                                const std::string& path,
+                                                const std::string& configIface)
+{
+    const std::string muxChannelIface = configIface + ".MuxChannel";
+    auto muxName = co_await dbusGetRequiredProperty<std::string>(
+        ctx, service, path, muxChannelIface, "MuxName");
+    auto channelName = co_await dbusGetRequiredProperty<std::string>(
+        ctx, service, path, muxChannelIface, "ChannelName");
+
+    if (!muxName.has_value() || muxName->empty() || !channelName.has_value() ||
+        channelName->empty())
+    {
+        error("Missing or empty MuxChannel property on path {PATH}", "PATH",
+              path);
+        co_return std::nullopt;
+    }
+
+    const fs::path linkPath =
+        fs::path("/dev/i2c-mux") / *muxName / *channelName;
+    std::error_code ec;
+    const bool isSymlink = fs::is_symlink(linkPath, ec);
+    if (ec)
+    {
+        error("Failed to inspect I2C mux path {PATH}: {ERROR}", "PATH",
+              linkPath.string(), "ERROR", ec.message());
+        co_return std::nullopt;
+    }
+    if (!isSymlink)
+    {
+        error("I2C mux path {PATH} is not a symbolic link", "PATH",
+              linkPath.string());
+        co_return std::nullopt;
+    }
+
+    const fs::path target = fs::read_symlink(linkPath, ec);
+    if (ec)
+    {
+        error("Failed to read I2C mux symbolic link {PATH}: {ERROR}", "PATH",
+              linkPath.string(), "ERROR", ec.message());
+        co_return std::nullopt;
+    }
+
+    const std::string deviceName = target.filename().string();
+    constexpr std::string_view prefix = "i2c-";
+    if (!deviceName.starts_with(prefix))
+    {
+        error("Invalid I2C mux symbolic link target {TARGET}", "TARGET",
+              target.string());
+        co_return std::nullopt;
+    }
+
+    const std::string_view busString(deviceName.data() + prefix.size(),
+                                     deviceName.size() - prefix.size());
+    uint64_t resolvedBusNo = 0;
+    const auto [end, parseError] = std::from_chars(
+        busString.data(), busString.data() + busString.size(), resolvedBusNo);
+    if (busString.empty() || parseError != std::errc{} ||
+        end != busString.data() + busString.size())
+    {
+        error("Invalid I2C bus number in symbolic link target {TARGET}",
+              "TARGET", target.string());
+        co_return std::nullopt;
+    }
+
+    debug("Resolved I2C mux channel {MUX}/{CHANNEL} to bus {BUS}", "MUX",
+          *muxName, "CHANNEL", *channelName, "BUS", resolvedBusNo);
+    co_return resolvedBusNo;
+}
