     std::unique_ptr<void, std::function<void(void*)>>& pldmPackage,
@@ -73,6 +96,62 @@ sdbusplus::async::task<bool> Device::startUpdateAsync(
     std::unique_ptr<Software> softwarePendingIn)
 // NOLINTEND(readability-static-accessed-through-instance)
 {
+    auto redfishUpdateFailedLog = [this](const uint8_t* image, size_t imageSize,
+                                         const std::string& target,
+                                         const std::string& version) {
+        std::ostringstream path;
+        path << "/tmp/update_error_0x" << std::hex
+             << reinterpret_cast<std::uintptr_t>(image) << '_' << std::dec
+             << imageSize << ".log";
+        const std::string errorLogPath = path.str();
+        std::string updateError = "Firmware update failed";
+        std::error_code errorCode;
+        const bool errorLogExists =
+            std::filesystem::exists(errorLogPath, errorCode);
+
+        if (errorCode)
+        {
+            lg2::warning("Failed to check update error log {PATH}: {ERROR}",
+                         "PATH", errorLogPath, "ERROR", errorCode.message());
+        }
+        else if (errorLogExists)
+        {
+            {
+                std::ifstream errorLogFile(errorLogPath);
+                std::string firstLine;
+                if (!errorLogFile.is_open())
+                {
+                    lg2::warning("Failed to open update error log {PATH}",
+                                 "PATH", errorLogPath);
+                }
+                else if (!std::getline(errorLogFile, firstLine) ||
+                         firstLine.empty())
+                {
+                    lg2::warning("Update error log {PATH} is empty", "PATH",
+                                 errorLogPath);
+                }
+                else
+                {
+                    updateError = std::move(firstLine);
+                }
+            }
+        }
+
+        redfishLog("FirmwareUpdateFailed", target, version, updateError);
+
+        if (errorLogExists)
+        {
+            errorCode.clear();
+            if (!std::filesystem::remove(errorLogPath, errorCode))
+            {
+                lg2::warning(
+                    "Failed to remove update error log {PATH}: {ERROR}", "PATH",
+                    errorLogPath, "ERROR",
+                    errorCode ? errorCode.message() : "file no longer exists");
+            }
+        }
+    };
+
     debug("starting the async update with memfd {FD}", "FD", image.fd);
 
     size_t pldm_pkg_size = 0;
