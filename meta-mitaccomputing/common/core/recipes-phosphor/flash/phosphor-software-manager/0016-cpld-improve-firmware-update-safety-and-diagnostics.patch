+#pragma once
+
+#include <sdbusplus/async/context.hpp>
+#include <sdbusplus/async/task.hpp>
+
+#include <cstddef>
+
+namespace phosphor::software::cpld
+{
+
+class CPLDRebootGuard
+{
+  public:
+    explicit CPLDRebootGuard(sdbusplus::async::context& ctx);
+
+    CPLDRebootGuard(const CPLDRebootGuard&) = delete;
+    CPLDRebootGuard& operator=(const CPLDRebootGuard&) = delete;
+    CPLDRebootGuard(CPLDRebootGuard&&) = delete;
+    CPLDRebootGuard& operator=(CPLDRebootGuard&&) = delete;
+
+    sdbusplus::async::task<bool> acquire();
+    sdbusplus::async::task<> release();
+    sdbusplus::async::task<> cleanupStaleGuard();
+
+  private:
+    enum class GuardState
+    {
+        inactive,
+        active,
+        unknown,
+    };
+
+    struct RemoveGuardResult
+    {
+        bool allRemoved = false;
+        bool removedAny = false;
+    };
+
+    sdbusplus::async::task<> waitForTransition();
+    sdbusplus::async::task<GuardState> enableGuard();
+    sdbusplus::async::task<GuardState> disableGuard();
+    sdbusplus::async::task<GuardState> rollbackGuard();
+    sdbusplus::async::task<bool> restoreGuard();
+    sdbusplus::async::task<bool> reloadSystemd();
+    sdbusplus::async::task<RemoveGuardResult> removeGuardFiles();
+
+    bool createGuardFiles();
+
+    sdbusplus::async::context& ctx;
+    size_t activeUsers = 0;
+    GuardState guardState = GuardState::inactive;
+    bool transitionInProgress = false;
+};
+
+} // namespace phosphor::software::cpld
