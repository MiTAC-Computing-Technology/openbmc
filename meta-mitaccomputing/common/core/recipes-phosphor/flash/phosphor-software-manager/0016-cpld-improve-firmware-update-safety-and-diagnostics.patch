     }
 
+    const bool rebootGuardAcquired = co_await rebootGuard.acquire();
+    if (!rebootGuardAcquired)
+    {
+        lg2::warning(
+            "Failed to enable the CPLD reboot guard; continuing the update");
+    }
+
     setUpdateProgress(1);
-    if (!(co_await cpldInterface->updateFirmware(
+    bool updateSucceeded = false;
+#ifndef CPLD_DEBUG
+    try
+    {
+        updateSucceeded = co_await cpldInterface->updateFirmware(
             false, image, image_size, [this](int percent) -> bool {
                 return this->setUpdateProgress(percent);
-            })))
+            });
+    }
+    catch (const std::exception& e)
+    {
+        lg2::error("CPLD firmware update threw an exception: {ERROR}", "ERROR",
+                   e.what());
+        updateSucceeded = false;
+    }
+    catch (...)
+    {
+        lg2::error("CPLD firmware update threw an unknown exception");
+        updateSucceeded = false;
+    }
+#else
+    static_cast<void>(image);
+    static_cast<void>(image_size);
+    lg2::warning(
+        "CPLD_DEBUG is enabled; simulating a firmware update for 60 seconds without writing the CPLD");
+    co_await sdbusplus::async::sleep_for(ctx, std::chrono::seconds(60));
