From 430adcbccfb9003e77b5e813a41a79000e6cbae5 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Thu, 4 Jun 2026 01:24:36 +0000
Subject: [PATCH 2/2] Update Kconfig and Makefile to support the configuration
 for mic-cpld-4826.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 drivers/hwmon/Kconfig  | 9 +++++++++
 drivers/hwmon/Makefile | 1 +
 2 files changed, 10 insertions(+)

diff --git a/drivers/hwmon/Kconfig b/drivers/hwmon/Kconfig
index bc911e4c6713..ab08ff738eaf 100644
--- a/drivers/hwmon/Kconfig
+++ b/drivers/hwmon/Kconfig
@@ -1349,6 +1349,15 @@ config SENSORS_MENF21BMC_HWMON
 	  This driver can also be built as a module. If so the module
 	  will be called menf21bmc_hwmon.
 
+config SENSORS_MIC_CPLD_4826
+	tristate "MITAC CPLD 4826"
+	depends on I2C
+	help
+	  If you say yesdd here you get support for Mitac CPLD 4826.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called mic_cpld_4826.
+
 config SENSORS_MR75203
 	tristate "Moortec Semiconductor MR75203 PVT Controller"
 	select REGMAP_MMIO
diff --git a/drivers/hwmon/Makefile b/drivers/hwmon/Makefile
index efdaf0910152..523082147c0c 100644
--- a/drivers/hwmon/Makefile
+++ b/drivers/hwmon/Makefile
@@ -164,6 +164,7 @@ obj-$(CONFIG_SENSORS_MC34VR500)	+= mc34vr500.o
 obj-$(CONFIG_SENSORS_MCP3021)	+= mcp3021.o
 obj-$(CONFIG_SENSORS_TC654)	+= tc654.o
 obj-$(CONFIG_SENSORS_TPS23861)	+= tps23861.o
+obj-$(CONFIG_SENSORS_MIC_CPLD_4826)  += mic-cpld-4826.o
 obj-$(CONFIG_SENSORS_MLXREG_FAN) += mlxreg-fan.o
 obj-$(CONFIG_SENSORS_MENF21BMC_HWMON) += menf21bmc_hwmon.o
 obj-$(CONFIG_SENSORS_MR75203)	+= mr75203.o
-- 
2.43.0

