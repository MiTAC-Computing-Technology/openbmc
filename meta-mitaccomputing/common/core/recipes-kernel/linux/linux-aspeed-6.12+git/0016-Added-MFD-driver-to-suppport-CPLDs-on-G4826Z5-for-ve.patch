+++ b/drivers/hwmon/mic-cpld-4826.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/types.h>
+#include <linux/mutex.h>
+#include <linux/gpio/driver.h>
+
+#define REG_PWM(ch) (0x31 + (ch))
+#define REG_TACH_1(ch) (0x11 + (ch))
+#define REG_TACH_2(ch) (0x21 + (ch))
+#define REG_LEAKAGE 0x08
+
+#define MAX_PWM_CHANNELS 16
+#define MAX_COOLING_LEVEL 5
+
+enum chips {
+	FAN_CTRL_ONLY,
+	CPLD_PDB,
+	CPLD_UBB,
+	CPLD_PCIE_BAY,
+	CPLD_HSBP,
+	CPLD_SW
+};
+
+struct GPIO_DEF_ENTRY {
+	u8 reg_id;
+	u8 output_mask;
+	u8 input_mask;
+};
+
+// For G4826-Z5 PDB CPLD
+const struct GPIO_DEF_ENTRY gpio_cfg_pdb[] = {
+	{ 0x08, 0x00, 0x03 },
+	{ 0x20, 0x00, 0xff },
+	{ 0x37, 0x07, 0xF8 },
+};
+
+// For G4826-Z5 UBB FCB CPLD.
+const struct GPIO_DEF_ENTRY gpio_cfg_ubb[] = {
+	{ 0x08, 0x00, 0x0f },
+};
+
+// For G4826-Z5 HSBP CPLD
+const struct GPIO_DEF_ENTRY gpio_cfg_hsbp[] = {
+	{ 0x00, 0x00, 0x1f }, // Drive 0
+	{ 0x01, 0x07, 0x00 }, { 0x02, 0x00, 0x1f }, // Drive 1
+	{ 0x03, 0x07, 0x00 }, { 0x04, 0x00, 0x1f }, // Drive 2
+	{ 0x05, 0x07, 0x00 }, { 0x06, 0x00, 0x1f }, // Drive 3
+	{ 0x07, 0x07, 0x00 }, { 0x08, 0x00, 0x1f }, // Drive 4
+	{ 0x09, 0x07, 0x00 }, { 0x0a, 0x00, 0x1f }, // Drive 5
+	{ 0x0b, 0x07, 0x00 }, { 0x0c, 0x00, 0x1f }, // Drive 6
+	{ 0x0d, 0x07, 0x00 }, { 0x0e, 0x00, 0x1f }, // Drive 7
+	{ 0x0f, 0x07, 0x00 },
+};
+
+struct cpld_pwm_port {
+	struct mic_cpld_4826_data *priv;
+	struct thermal_cooling_device *cdev;
+	u32 channel;
+	u32 *cooling_levels;
+	int num_levels;
+	unsigned long cur_state;
+};
+
+struct mic_cpld_4826_data {
+	enum chips chip_id;
+	struct i2c_client *client;
+	struct mutex lock;
+
+	// Reg Setting
+
+	// Properties for GPIO Control
+	struct gpio_chip gpio_chip;
+	struct GPIO_DEF_ENTRY *gpio_cfg;
+	size_t gpio_port_num;
+
+	// Properties for Fan Control
+	bool enable_hwmon;
+	struct device *hwmon_dev;
+
+	// Properties for Thermal Cooling Device
+	struct cpld_pwm_port pwm_ports[MAX_PWM_CHANNELS];
+};
