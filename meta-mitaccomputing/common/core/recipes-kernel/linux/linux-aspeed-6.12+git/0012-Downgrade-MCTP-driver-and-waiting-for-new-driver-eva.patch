 	u32 length : 10, rsvd0 : 2, attr : 2, ep : 1, td : 1, rsvd1 : 4, tc : 3,
 		rsvd2 : 1, route_type : 5, fmt : 2, rsvd3 : 1;
@@ -87,11 +118,31 @@ struct mctp_pcie_vdm_hdr {
 	u16 pci_target_id;
 };
 
